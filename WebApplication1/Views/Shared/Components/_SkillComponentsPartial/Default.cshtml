@using MyPortfolio.DAL.Entities


@model List<Skill>



<div class="col-six tab-full right">
    <h3>Programlama Dİlleri & Teknolojiler</h3>

    <ul class="skill-bars">

       @foreach (var item in Model)
       {
            <li>
                <div class="progress percent"><span>@item.Value%</span></div>
                <strong>@item.Title</strong>
            </li>

       }
       
    </ul>
</div>